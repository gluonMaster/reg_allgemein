{
	"name": "reg-allgemein",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "npm run check:src",
		"check:src": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml --persist-to .wrangler/state",
		"db:migrations:local": "wrangler d1 migrations list DB --local --config wrangler.local.toml --persist-to .wrangler/state",
		"db:reset:local": "node scripts/reset-local-d1.js",
		"db:period:local": "tsx scripts/ensure-academic-period.ts",
		"import:price:local": "tsx scripts/import-references.ts price",
		"import:schedule:local": "tsx scripts/import-references.ts schedule",
		"import:plusbtext:local": "tsx scripts/import-references.ts plusbtext",
		"import:access:local": "tsx scripts/import-references.ts access",
		"import:status:local": "tsx scripts/import-references.ts status",
		"import:rollback:local": "tsx scripts/import-references.ts rollback",
		"deploy": "npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260708.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/postcss": "^4.1.15",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24.0.0",
		"@types/qrcode": "^1.5.5",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"fflate": "^0.8.3",
		"mdb-reader": "^3.2.0",
		"miniflare": "^4.20251011.0",
		"node-html-parser": "^6.1.13",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"read-excel-file": "^9.3.1",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.15",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.4",
		"wrangler": "^4.43.0"
	},
	"dependencies": {
		"@lucide/svelte": "^0.552.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"bcryptjs": "^3.0.2",
		"jose": "^6.1.0",
		"qrcode": "^1.5.4",
		"zod": "^4.1.12"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
