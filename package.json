		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24.0.0",
		"@types/qrcode": "^1.5.5",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"miniflare": "^4.20251011.0",
		"node-html-parser": "^6.1.13",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
