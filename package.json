{
	"name": "reg-allgemein",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "npm run check:src",
		"check:src": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "playwright test",
		"test:watch": "vitest",
		"docs:check": "tsx scripts/check-doc-links.ts && tsx scripts/check-doc-commands.ts && tsx scripts/check-stage13-continuity.ts",
		"release:scan": "tsx scripts/release-scan.ts",
		"release:verify": "npm run check && npm test && npm run test:e2e && npm run build && npm audit --omit=dev && npm run docs:check && npm run release:scan",
		"admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.toml --persist-to .wrangler/state",
		"db:migrations:local": "wrangler d1 migrations list DB --local --config wrangler.local.toml --persist-to .wrangler/state",
		"db:reset:local": "node scripts/reset-local-d1.js",
		"db:period:local": "tsx scripts/ensure-academic-period.ts",
		"db:period:confirmation:remote": "tsx scripts/ensure-academic-period-remote.ts confirmation",
		"db:period:remote": "tsx scripts/ensure-academic-period-remote.ts apply --remote",
		"db:period:reconcile:remote": "tsx scripts/ensure-academic-period-remote.ts reconcile --remote",
		"import:price:local": "tsx scripts/import-references.ts price",
		"import:schedule:local": "tsx scripts/import-references.ts schedule",
		"import:plusbtext:local": "tsx scripts/import-references.ts plusbtext",
		"import:access:local": "tsx scripts/import-references.ts access",
		"import:status:local": "tsx scripts/import-references.ts status",
		"import:rollback:local": "tsx scripts/import-references.ts rollback",
		"import:legacy:plan:remote": "tsx scripts/import-legacy-release.ts plan --remote",
		"import:legacy:stage:remote": "tsx scripts/import-legacy-release.ts stage --remote",
		"import:legacy:review:remote": "tsx scripts/import-legacy-release.ts review --remote",
		"import:legacy:recovery-evidence:remote": "tsx scripts/import-legacy-release.ts recovery-evidence --remote",
		"import:legacy:confirmation:remote": "tsx scripts/import-legacy-release.ts confirmation --remote",
		"import:legacy:promote:remote": "tsx scripts/import-legacy-release.ts promote --remote",
		"import:legacy:verify:remote": "tsx scripts/import-legacy-release.ts verify --remote",
		"import:legacy:rollback:remote": "tsx scripts/import-legacy-release.ts rollback --remote",
		"import:legacy:roll-forward:remote": "tsx scripts/import-legacy-release.ts roll-forward --remote",
		"telegram:preflight": "tsx scripts/telegram-provider-check.ts preflight",
		"telegram:deployment-evidence:create": "tsx scripts/telegram-preview-deployment-evidence-create.ts create",
		"telegram:target:create": "tsx scripts/telegram-preview-target-create.ts create",
		"telegram:smoke:target": "tsx scripts/telegram-preview-smoke.ts target",
		"telegram:smoke:prepare": "tsx scripts/telegram-preview-smoke.ts prepare --remote",
		"telegram:smoke:run": "tsx scripts/telegram-preview-smoke.ts run --remote",
		"telegram:smoke:abort": "tsx scripts/telegram-preview-smoke.ts abort --remote",
		"telegram:smoke:reconcile": "tsx scripts/telegram-preview-smoke.ts reconcile --remote",
		"telegram:smoke:verify": "tsx scripts/telegram-preview-smoke.ts verify --remote",
		"deploy": "npm run build && wrangler deploy"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/workers-types": "^5.20260811.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/postcss": "^4.1.15",
		"@types/bcryptjs": "^2.4.6",
		"@types/node": "^24.0.0",
		"@types/qrcode": "^1.5.5",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.21",
		"fflate": "^0.8.3",
		"mdb-reader": "^3.2.0",
		"miniflare": "^5.20260804.0-alpha",
		"node-html-parser": "^6.1.13",
		"postcss": "^8.5.26",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"read-excel-file": "^9.3.1",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.15",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.4",
		"wrangler": "^4.120.1"
	},
	"dependencies": {
		"@lucide/svelte": "^0.552.0",
		"bcryptjs": "^3.0.2",
		"jose": "^6.1.0",
		"qrcode": "^1.5.4",
		"zod": "^4.1.12"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	}
}
